// Tang Nano 4K — Test A_2 — GC0308 configuration + first-HSYNC synthetic test.
// Top module: TestA2_GC0308_HyperRAM
IO_LOC  "clk8" 35;
IO_PORT "clk8" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC  "uart_tx_o" 32;
IO_PORT "uart_tx_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// Tang Nano 4K KEY2/S2, active-low global reset.
IO_LOC  "key2_n_i" 15;
IO_PORT "key2_n_i" IO_TYPE=LVCMOS18 PULL_MODE=NONE;

// GC0308 connector: MCLK, SCCB and HSYNC only.
// Sensor PCLK, VSYNC and D[7:0] are intentionally absent from this design.
IO_LOC  "cam_clk" 33;
IO_PORT "cam_clk" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "cam_scl" 44;
IO_PORT "cam_scl" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "cam_sda" 46;
IO_PORT "cam_sda" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "cam_hsync" 42;
IO_PORT "cam_hsync" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
