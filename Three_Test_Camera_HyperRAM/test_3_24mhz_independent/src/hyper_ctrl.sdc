# Test 3: 8 MHz board oscillator is the reference for the 24 MHz PLL output.
create_clock -name clk8_ref -period 125.000 -waveform {0 62.500} [get_ports {clk8}]

# The 24 MHz capture/generator clock is produced by Gowin_PLLVR_1 from clk8.
# HyperRAM memory/user clocks are generated by the existing Gowin PLL/IP.
# cam_pclk is unused in this experiment; no camera timing constraint is needed.
