# Test 3: the external 8 MHz oscillator is the PLL reference.
create_clock -name clk8_ref -period 125.000 -waveform {0 62.500} [get_ports {clk8}]

# Internal 24 MHz and 96 MHz clocks are generated by Gowin PLL IP.
# The capture generator, RGB565 packer, and FIFO write side use clk24.
# The HyperRAM IP user interface and writer FSM use its clk_out (usr_clk).
# cam_pclk remains an unused legacy input pin; it is NOT a clock in this test.
