# External 8 MHz oscillator is only the PLL reference.
create_clock -name clk8_ref -period 125.000 -waveform {0 62.500} [get_ports {clk8}]

# Fabric clock generated by Gowin_PLLVR_1: 8 MHz * 3 = 24 MHz.
create_generated_clock -name clk24 -source [get_ports {clk8}] -multiply_by 3 [get_pins {u_pll_24/clkout}]

# HyperRAM reference clock generated from the 24 MHz fabric clock: 96 MHz.
create_generated_clock -name clk96 -source [get_pins {u_pll_24/clkout}] -multiply_by 4 [get_pins {u_pll_96/clkout}]
