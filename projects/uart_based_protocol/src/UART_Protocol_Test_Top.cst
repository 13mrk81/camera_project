// Tang Nano 4K - UART frame protocol test top
// clk8: 8 MHz board oscillator
// UART: 115200 baud, 8N1 (FPGA RX/TX are crossed with USB-UART adapter)

IO_LOC  "clk8"       35;
IO_PORT "clk8"       IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC  "uart_rx_i"  39;
IO_PORT "uart_rx_i"  IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "uart_tx_o"  40;
IO_PORT "uart_tx_o"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

IO_LOC  "led_status" 10;
IO_PORT "led_status" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
